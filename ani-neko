#!/bin/bash

VERSION="1.4.1"

CONTINUE=0
progress="00:00:00"

# cosas para texto
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[0;33m'
BLUE='\033[0;34m'
PURPLE='\033[0;35m'
CYAN='\033[0;36m'
WHITE='\033[0;37m'

# cosas para el fondo del texto
BG_RED='\033[41m'
BG_GREEN='\033[42m'
BG_YELLOW='\033[43m'
BG_BLUE='\033[44m'
BG_PURPLE='\033[45m'
BG_CYAN='\033[46m'
BG_WHITE='\033[47m'

NC='\033[0m'

# User-Agent que usamos para todas las peticiones
UA="Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/91.0.4472.124 Safari/537.36"

HISTORY_DIR="$HOME/ani-es"
OLD_DB="$HISTORY_DIR/history.db"
HISTORY_FILE="$HOME/ani-es/history.json"

# Directorio temporal de trabajo (resultados, cookies, ...)
WORKDIR="$(mktemp -d)"
RESULTADOS="$WORKDIR/resultados.txt"
COOKIES="$WORKDIR/cookies.txt"
trap 'rm -rf "$WORKDIR"' EXIT

init_history() {

    mkdir -p "$HISTORY_DIR"

    [[ -f "$HISTORY_FILE" ]] || echo "{}" > "$HISTORY_FILE"

    if [[ -f "$OLD_DB" ]]; then

        echo
        echo "El sistema de guardado de historial ha cambiado."
        read -rp "¿Desea importar su antiguo historial? (y/n): " respuesta

        if [[ "$respuesta" =~ ^[YySs]$ ]]; then

            echo "Importando historial..."

            if python3 <<EOF
import sqlite3
import json

db_path = "$OLD_DB"
json_path = "$HISTORY_FILE"

try:
    with open(json_path, "r", encoding="utf-8") as f:
        history = json.load(f)
except:
    history = {}

conn = sqlite3.connect(db_path)
cursor = conn.cursor()

cursor.execute("""
SELECT name
FROM sqlite_master
WHERE type='table' AND name='animes'
""")

if cursor.fetchone():

    cursor.execute("SELECT anime,last_cap,progress FROM animes")

    for anime,last_cap,progress in cursor.fetchall():

        try:
            last_cap = int(last_cap)
        except (TypeError, ValueError):
            last_cap = 0

        if not progress:
            progress = "00:00:00"

        history[anime] = {
            "last_cap": last_cap,
            "progress": progress
        }

conn.close()

with open(json_path, "w", encoding="utf-8") as f:
    json.dump(history, f, indent=4, ensure_ascii=False)

EOF
            then
                rm -f "$OLD_DB"
                echo "Historial importado correctamente."
            else
                echo "Ha ocurrido un error durante la importación."
                echo "La base de datos antigua no se ha eliminado."
            fi

        else
            rm -f "$OLD_DB"
            echo "El historial antiguo ha sido eliminado."
        fi
    fi
}

init_history

clear
get_last_cap() {
    jq -r --arg anime "$1" \
        '.[$anime].last_cap // ""' \
        "$HISTORY_FILE"
}


get_progress() {
    jq -r --arg anime "$1" \
        '.[$anime].progress // "00:00:00"' \
        "$HISTORY_FILE"
}


save_history() {
    local anime="$1"
    local cap="$2"
    local progress="$3"

    tmp=$(mktemp)

    jq \
        --arg anime "$anime" \
        --arg cap "$cap" \
        --arg progress "$progress" \
        '.[$anime] = {
            last_cap: ($cap|tonumber),
            progress: $progress
        }' \
        "$HISTORY_FILE" > "$tmp"

    mv "$tmp" "$HISTORY_FILE"
}


show_help() {
    echo ""
    echo "    Uso: ani-neko [opciones] [busqueda]"
    echo ""
    echo "    Opciones:"
    echo "      -h, --help       Mostrar ayuda"
    echo "      -v, --version    Mostrar versión"
    echo "      -c, --continue   Continua el anime en donde ultimo lo dejaste"
    echo ""
}

show_version() {
    echo -e "ani-neko ${PURPLE}v${VERSION}${NC}"
}

# parseo de argumentos
while [[ $# -gt 0 ]]; do
    case "$1" in
        -h|--help)
            show_help
            exit 0
            ;;
        -v|--version)
            show_version
            exit 0
            ;;
        -c|--continue)
            CONTINUE=1
            ;;
        *)
            break
            ;;
    esac
    shift
done


arg1="$*"


check_dependencies() {
    local script_name
    script_name=$(basename "$0")
    local missing=()

    for cmd in "$@"; do
        if ! command -v "$cmd" &> /dev/null; then
            missing+=("$cmd")
        fi
    done

    if [ ${#missing[@]} -ne 0 ]; then
        echo -e "${CYAN}[$script_name]${RED} Dependencias faltantes:${NC}"
        for pkg in "${missing[@]}"; do
            echo -e "${CYAN}  - $pkg ${NC}"
        done
        echo -e "${GREEN}Ejecuta el instalador antes de usar este script.${NC}"
        exit 1
    fi
}

detect_env() {
    # WSL (1 o 2)
    if grep -qi microsoft /proc/version 2>/dev/null || [ -n "$WSL_DISTRO_NAME" ]; then
        echo "wsl"
    # Termux (Android)
    elif [ -n "$PREFIX" ] && [[ "$PREFIX" == *com.termux* ]]; then
        echo "termux"
    # Linux normal
    else
        echo "linux"
    fi
}

# ---------------------------------------------------------------------------
# Parseo del HTML de jkanime
#   modo "search"  -> resultados del buscador
#   modo "related" -> seccion "Temporadas y relacionados" (secuela, precuela,
#                     adicional, derivado...), ignorando generos/estudios
# Devuelve lineas "titulo<TAB>url"
# ---------------------------------------------------------------------------
parse_html() {
    python3 -I -c '
import sys, re, html
mode = sys.argv[1]
data = sys.stdin.read()
BAD = ("/genero/","/studio/","/temporada/","/letra/","/buscar/","/ver/","/peliculas/","/directorio","/perfil/")
def clean(t):
    t = re.sub(r"\s+", " ", html.unescape(t)).strip()
    t = re.sub(r"\s*\((?:Serie|OVA|ONA|Pel[ií]cula|Especial|Especiales|Movie)\)\s*$", "", t).strip()
    return t
out = []
if mode == "search":
    for m in re.finditer(r"<h5><a\s+href=\"([^\"]+)\"[^>]*>(.*?)</a></h5>", data, re.S):
        out.append((clean(m.group(2)), m.group(1)))
else:
    i = data.find("Temporadas y relacionados")
    if i >= 0:
        ends = [x for x in (data.find("Te recomendamos", i), data.find("personajes animetab", i)) if x > 0]
        j = min(ends) if ends else i + 4000
        block = data[i:j]
        for m in re.finditer(r"<a\s+href=\"(https://jkanime\.net/[^\"]+)\"[^>]*>(.*?)</a>", block, re.S):
            u = m.group(1); t = clean(m.group(2))
            if any(b in u for b in BAD) or not t:
                continue
            out.append((t, u))
seen = set()
for t, u in out:
    if not t or t in seen:
        continue
    seen.add(t)
    sys.stdout.write(t + "\t" + u + "\n")
' "$1"
}

# Busca un anime y le anade sus temporadas/secuelas.
# El resultado se guarda en "$RESULTADOS" como "titulo<TAB>url".
buscar_anime() {
    local q="$1"
    local qs="${q// /_}"
    local search_out related_out seed

    search_out=$(curl -s -A "$UA" "https://jkanime.net/buscar/$qs/" | parse_html search)

    # Ampliamos con la seccion "Temporadas y relacionados" del primer resultado,
    # asi al buscar "death note" tambien aparecen sus secuelas/temporadas.
    seed=$(printf '%s\n' "$search_out" | head -n1 | cut -f2)
    related_out=""
    if [ -n "$seed" ]; then
        related_out=$(curl -s -A "$UA" -L "$seed" | parse_html related)
    fi

    printf '%s\n%s\n' "$search_out" "$related_out" \
        | awk -F'\t' 'NF>=2 && !seen[$1]++' > "$RESULTADOS"
}

main() {

urlo="https://raw.githubusercontent.com/rlssj/ani-neko/refs/heads/main/ani-neko"
SCRIPT_DIR=$(dirname "$(readlink -f "$0")")
ARCHIVO="$SCRIPT_DIR/ani-neko"

echo -e "${BLUE}Verificando actualizaciones disponibles...${NC}"
update=$(curl -s "$urlo")

if [ "$update" != "$(cat "$ARCHIVO")" ]; then
    echo -n -e "${CYAN}Hay una actualizacion disponible se recomienda actualizar para garantizar que el script funcione correctamente (y/n) ${NC}"
    read ele
    if [ "$ele" == "y" ]; then
        diff -u "$ARCHIVO" <(echo "$update") | sudo patch "$ARCHIVO" > /dev/null 2>&1 && echo -e "${CYAN}El script ha sido actualizado${NC}" || echo -e "${RED}Ha ocurrido un error mientras se actualizaba el script${NC}"
        exit 0
    fi
else
    echo "Script actualizado"
fi

clear

check_dependencies curl fzf grep sed python3 mpv jq

if [[ -z "$arg1" ]]; then
  read -p "Buscar Anime: " oracion
  clear
else
  oracion="$arg1"
fi

buscar_anime "$oracion"

num_animes=$(grep -c . "$RESULTADOS" 2>/dev/null)
[[ -z "$num_animes" ]] && num_animes=0

if [[ "$num_animes" -eq 0 ]]; then
  echo -e "${RED}No se encontraron resultados para:${NC} $oracion"
  exit 1
elif [[ "$num_animes" -eq 1 ]]; then
  opcion=$(cut -f1 "$RESULTADOS")
  nuevaurl=$(cut -f2 "$RESULTADOS")
  echo "Cargando..."
else
  echo -e "Resultados para: $oracion"
  opcion=$( (cut -f1 "$RESULTADOS"; echo "Salir") | tac | fzf --prompt="Selecciona una opción: " --height=~20 --border --info=inline --margin=1,1,0,0 )
  clear
  if [[ -z "$opcion" || "$opcion" == "Salir" ]]; then
    main
  fi
  nuevaurl=$(awk -F'\t' -v t="$opcion" '$1==t{print $2; exit}' "$RESULTADOS")
fi

titulo_elegido="$opcion"

if [ -z "$nuevaurl" ]; then
  echo -e "${RED}No se pudo obtener el enlace del anime.${NC}"
  exit 1
fi

# Evitamos la doble barra al concatenar la url del episodio (".../anime//1")
nuevaurl="${nuevaurl%/}"

echo "Cargando..."

# Descargamos la ficha del anime
anime_page=$(curl -s -A "$UA" -L -c "$COOKIES" "$nuevaurl")

clear
echo -e "Anime: $GREEN $titulo_elegido $WHITE"

last_cap=$(get_last_cap "$titulo_elegido")

tipo=$(printf '%s' "$anime_page" | grep -oP '<span>Tipo:</span> \K[^<]+' | tail -n 1)

# Recuento de episodios usando la API interna de jkanime
token=$(printf '%s' "$anime_page" | grep -oP 'meta name="csrf-token" content="\K[^"]+')
api_url_base=$(printf '%s' "$anime_page" | grep -oP "url:\s*'\Khttps://jkanime\.net/ajax/episodes/\d+/?" | head -1)

num_episodios=""
if [ -n "$api_url_base" ] && [ -n "$token" ]; then
    json_response=$(curl -s -X POST "$api_url_base" \
        -b "$COOKIES" -A "$UA" \
        -H "X-Requested-With: XMLHttpRequest" \
        -H "X-CSRF-TOKEN: $token" \
        --data-urlencode "_token=$token")

    num_episodios=$(printf '%s' "$json_response" | grep -oP '"total":\s*\K\d+')
fi

echo -e "Ultimo episodio visto: $last_cap"

if [ -z "$num_episodios" ]; then
    num_episodios=0
fi

if [ "$num_episodios" -eq 0 ]; then
  echo -e "Enlace ${CYAN}$nuevaurl${NC} no válido. Por favor ve a ${GREEN}https://github.com/rlssj/ani-neko${NC} y abre un issue especificando el enlace y el anime que estabas intentando ver. Lo corregiré y actualizaré el script ;)"
  exit 1
fi



if [ "$CONTINUE" == 1 ]; then
  capi=$last_cap
  progress=$(get_progress "$titulo_elegido")

else
  capi=$(seq 1 "$num_episodios" | fzf \
    --prompt="Episodio: " \
    --height=~30 \
    --border \
    --reverse)
fi

clear

if [ "$tipo" == "Pelicula" ]; then
  capi="pelicula"
fi


capurl="$nuevaurl/$capi"


videocap(){
capa=$1

ep_html=$(curl -s -A "$UA" -L "$capa")

src_contenido=""

# Reproductor principal: jkplayer (um / umv)
player_url=$(printf '%s' "$ep_html" | grep -oP '<iframe[^>]+src="\Khttps://jkanime\.net/jkplayer/(?:um|umv)\?[^"]*' | head -1)
if [ -n "$player_url" ]; then
  src_contenido=$(curl -s -A "$UA" "$player_url" | grep -oP "url:\s*'\K[^']+" | head -1)
fi

# Alternativa: servidor Mediafire
if [ -z "$src_contenido" ]; then
  servers_line=$(printf '%s' "$ep_html" | grep -oP 'var servers = \[.*?\];' | head -1)

  if [ -n "$servers_line" ]; then
    mf_page=$(python3 -I -c '
import json, base64, re, sys
data = sys.argv[1]
m = re.search(r"var servers = (.+?);", data)
try:
    servers = json.loads(m.group(1))
    s = next((x for x in servers if x.get("server") == "Mediafire"), None)
    print(base64.b64decode(s["remote"]).decode().strip() if s else "")
except Exception:
    print("")
' "$servers_line")

    if [ -n "$mf_page" ]; then
      src_contenido=$(curl -s -A "$UA" -L "$mf_page" | grep -oP 'href="\Khttps://download[^"]+' | head -1)
    fi
  fi
fi

if [ -z "$src_contenido" ]; then
  echo -e "${RED}No se pudo obtener el enlace del video del capitulo $capi.${NC}"
  return 1
fi

if [ "$tipo" == "Pelicula" ]; then
  capi=1
fi

clear

echo "Capitulo: $capi"

ENV=$(detect_env)
pos=0

case "$ENV" in
    wsl)
        if command -v mpv.exe >/dev/null 2>&1; then
            pos=$(mpv.exe --start=$progress --msg-level=ffmpeg=no --force-media-title="$titulo_elegido-$capi" "$src_contenido" | grep -oE 'AV: [0-9]{2}:[0-9]{2}:[0-9]{2}' | tail -n 1  | sed 's/AV: //g' 2>&1)
        else
            echo "mpv.exe no encontrado en Windows PATH"
        fi
        ;;
    termux)
        if pm list packages | grep -q 'org.videolan.vlc'; then
            am start -a android.intent.action.VIEW -d "$src_contenido" -n org.videolan.vlc/org.videolan.vlc.gui.video.VideoPlayerActivity
            pos=0
        else
            termux-open-url "$src_contenido"
            pos=0
        fi
        ;;
    linux)
        if command -v mpv >/dev/null 2>&1; then
            pos=$(mpv --start=$progress -v --msg-level=ffmpeg=no --force-media-title="$titulo_elegido-$capi" "$src_contenido" | grep -oE 'AV: [0-9]{2}:[0-9]{2}:[0-9]{2}' | tail -n 1  | sed 's/AV: //g' 2>&1)
        fi
        ;;
esac

save_history "$titulo_elegido" "$capi" "$pos"

op=$( (echo "Siguiente"; echo "Retroceder"; echo "Atras") | tac | fzf --prompt="Selecciona una opción: " --height=7 --border --info=inline --margin=1,1,0,0)

if [[ "$op" == "Siguiente" ]]; then
    progress="00:00:00"
  capi=$((capi + 1))
    save_history "$titulo_elegido" "$capi" "$pos"
  videocap "$nuevaurl/$capi"
elif [[ "$op" == "Retroceder" ]]; then
  progress="00:00:00"
  capi=$((capi - 1))
  videocap "$nuevaurl/$capi"
elif [[ "$op" == "Atras" ]]; then

  main
fi
}
videocap $capurl
}



main
