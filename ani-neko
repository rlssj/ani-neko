#!/bin/bash

VERSION="3.0.0"

CONTINUE=0
CHANGE_SOURCE=0
progress="00:00:00"

# cosas para texto
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[0;33m'
BLUE='\033[0;34m'
PURPLE='\033[0;35m'
CYAN='\033[0;36m'
WHITE='\033[0;37m'

# cosas para el fondo del texto
BG_RED='\033[41m'
BG_GREEN='\033[42m'
BG_YELLOW='\033[43m'
BG_BLUE='\033[44m'
BG_PURPLE='\033[45m'
BG_CYAN='\033[46m'
BG_WHITE='\033[47m'

NC='\033[0m'

UA="Mozilla/5.0 (Windows NT 10.0; Win64; x64; rv:109.0) Gecko/20100101 Firefox/121.0"
ANIMEAV1="https://animeav1.com"
MIRURO="https://barelystarted.miruro.tv"
ZILLA_HEADERS="Origin:https://player.zilla-networks.com,Sec-Fetch-Dest:empty,Sec-Fetch-Mode:cors,Sec-Fetch-Site:same-origin"

HISTORY_DIR="$HOME/ani-es"
OLD_DB="$HISTORY_DIR/history.db"
HISTORY_FILE="$HISTORY_DIR/history.json"
SOURCE_FILE="$HISTORY_DIR/source"

WORKDIR="$(mktemp -d)"
trap 'rm -rf "$WORKDIR"' EXIT


init_history() {

    mkdir -p "$HISTORY_DIR"

    [[ -f "$HISTORY_FILE" ]] || echo "{}" > "$HISTORY_FILE"

    if [[ -f "$OLD_DB" ]]; then

        echo
        echo "El sistema de guardado de historial ha cambiado."
        read -rp "¿Desea importar su antiguo historial? (y/n): " respuesta

        if [[ "$respuesta" =~ ^[YySs]$ ]]; then

            echo "Importando historial..."

            if python3 <<EOF
import sqlite3
import json

db_path = "$OLD_DB"
json_path = "$HISTORY_FILE"

try:
    with open(json_path, "r", encoding="utf-8") as f:
        history = json.load(f)
except:
    history = {}

conn = sqlite3.connect(db_path)
cursor = conn.cursor()

cursor.execute("""
SELECT name
FROM sqlite_master
WHERE type='table' AND name='animes'
""")

if cursor.fetchone():

    cursor.execute("SELECT anime,last_cap,progress FROM animes")

    for anime,last_cap,progress in cursor.fetchall():

        try:
            last_cap = int(last_cap)
        except (TypeError, ValueError):
            last_cap = 0

        if not progress:
            progress = "00:00:00"

        history[anime] = {
            "last_cap": last_cap,
            "progress": progress
        }

conn.close()

with open(json_path, "w", encoding="utf-8") as f:
    json.dump(history, f, indent=4, ensure_ascii=False)

EOF
            then
                rm -f "$OLD_DB"
                echo "Historial importado correctamente."
            else
                echo "Ha ocurrido un error durante la importación."
                echo "La base de datos antigua no se ha eliminado."
            fi

        else
            rm -f "$OLD_DB"
            echo "El historial antiguo ha sido eliminado."
        fi
    fi
}

init_history

clear

get_last_cap() {
    jq -r --arg anime "$1" \
        '.[$anime].last_cap // ""' \
        "$HISTORY_FILE"
}


get_progress() {
    jq -r --arg anime "$1" \
        '.[$anime].progress // "00:00:00"' \
        "$HISTORY_FILE"
}


save_history() {
    local anime="$1"
    local cap="$2"
    local progress="$3"

    tmp=$(mktemp)

    jq \
        --arg anime "$anime" \
        --arg cap "$cap" \
        --arg progress "$progress" \
        '.[$anime] = {
            last_cap: ($cap|tonumber),
            progress: $progress
        }' \
        "$HISTORY_FILE" > "$tmp"

    mv "$tmp" "$HISTORY_FILE"
}


show_help() {
    echo ""
    echo "    Uso: ani-neko [opciones] [busqueda]"
    echo ""
    echo "    Opciones:"
    echo "      -h, --help       Mostrar ayuda"
    echo "      -v, --version    Mostrar versión"
    echo "      -c, --continue   Continua el anime en donde ultimo lo dejaste"
    echo "      -s, --source     Cambiar la fuente (AnimeAV1 o Miruro)"
    echo ""
    echo "    Fuentes:"
    echo "      AnimeAV1   Fuente por defecto (SUB)"
    echo "      Miruro     Respaldo: s-sub 1080p con subtitulos en español"
    echo ""
}

show_version() {
    echo -e "ani-neko ${PURPLE}v${VERSION}${NC}"
}

# parseo de argumentos
while [[ $# -gt 0 ]]; do
    case "$1" in
        -h|--help)
            show_help
            exit 0
            ;;
        -v|--version)
            show_version
            exit 0
            ;;
        -c|--continue)
            CONTINUE=1
            ;;
        -s|--source)
            CHANGE_SOURCE=1
            ;;
        *)
            break
            ;;
    esac
    shift
done


arg1="$*"


check_dependencies() {
    local missing=()

    echo "Checking dependencies..."

    for cmd in "$@"; do
        if ! command -v "$cmd" &> /dev/null; then
            missing+=("$cmd")
        fi
    done

    if [ ${#missing[@]} -ne 0 ]; then
        echo -e "${RED}Dependencias faltantes:${NC}"
        for pkg in "${missing[@]}"; do
            echo -e "${CYAN}  - $pkg ${NC}"
        done
        echo -e "${GREEN}Ejecuta el instalador antes de usar este script.${NC}"
        exit 1
    fi
}

detect_env() {
    # WSL (1 o 2)
    if grep -qi microsoft /proc/version 2>/dev/null || [ -n "$WSL_DISTRO_NAME" ]; then
        echo "wsl"
    # Termux (Android)
    elif [ -n "$PREFIX" ] && [[ "$PREFIX" == *com.termux* ]]; then
        echo "termux"
    # Linux normal
    else
        echo "linux"
    fi
}

# ---------------------------------------------------------------------------
# AnimeAV1
# ---------------------------------------------------------------------------

# Busca en el catalogo. Devuelve lineas "slug<TAB>titulo".
animeav1_search() {
    curl -s -A "$UA" -L --max-time 30 --connect-timeout 10 "$ANIMEAV1/catalogo?search=$(printf '%s' "$1" | sed 's/ /+/g')" \
        | tr '\n' ' ' \
        | sed 's|<article class="group/item|\n&|g' \
        | sed -nE 's|.*<h3[^>]*>([^<]+)</h3>.*href="/media/([^"/?]+)".*|\2\t\1|p'
}

# Lista de episodios de un anime (slug).
animeav1_episodes() {
    curl -s -A "$UA" -L --max-time 30 --connect-timeout 10 "$ANIMEAV1/media/$1" \
        | tr '\n' ' ' \
        | grep -oE 'number:[0-9]+(\.[0-9]+)?' | cut -d: -f2 \
        | awk '!seen[$0]++' | sort -n
}

# Solo se reproduce en SUB (audio japones, subtitulos en espanol).
# Nunca se cae a ESP/LAT/DUB: si el episodio solo tiene doblaje, no se reproduce.
pick_animeav1_language() {
    printf '%s' "$1" | grep -q 'SUB:\[' && { printf 'SUB\n'; return 0; }
    return 1
}

# Extrae las entradas "server:...,url:..." de un idioma del blob embeds/downloads.
extract_animeav1_entries() {
    [ -z "$1" ] && return 1
    printf '%s' "$1" | sed "s|.*$2:\\[||" \
        | sed 's|],*[A-Z][A-Z0-9]*:\[.*||; s|]$||; s|},{|}\n{|g'
}

extract_animeav1_hls_link() {
    local id
    id="$(printf '%s' "$1" | sed -nE 's|.*/play/([[:alnum:]]+).*|\1|p')"
    [ -n "$id" ] && printf 'https://player.zilla-networks.com/m3u8/%s\n' "$id"
}

extract_animeav1_pdrain_link() {
    local id
    id="$(printf '%s' "$1" | sed -nE 's|^https://pixeldrain\.com/u/([[:alnum:]]+)(\?.*)?$|\1|p')"
    [ -n "$id" ] && printf 'https://pixeldrain.com/api/file/%s\n' "$id"
}

extract_animeav1_mp4upload_link() {
    curl -s -A "$UA" -L --max-time 30 --connect-timeout 10 "$1" \
        | sed -nE 's|.*src:[[:space:]]*"(https?://[^"]+\.mp4[^"]*)".*|\1|p' | head -n 1
}

# Voe publica un JSON ofuscado (ROT13 + base64 + desplazamiento + inversión).
extract_animeav1_voe_link() {
    command -v python3 >/dev/null 2>&1 || return 1
    local embed="$1" page redirect
    page="$(curl -s -A "$UA" -L --max-time 30 --connect-timeout 10 "$embed")"
    redirect="$(printf '%s' "$page" | sed -nE "s|.*window.location.href = '(https://[^']+/e/[[:alnum:]]+)'.*|\1|p" | head -n 1)"
    if [ -n "$redirect" ]; then
        embed="$redirect"
        page="$(curl -s -A "$UA" -L --max-time 30 --connect-timeout 10 "$embed")"
    fi
    printf '%s' "$page" | python3 -c '
from base64 import b64decode
import codecs, json, re, sys
from urllib.parse import urlparse

match = re.search(r"<script\s+type=[\x27\x22]application/json[\x27\x22]>(.*?)</script>", sys.stdin.read(), re.S)
if not match:
    sys.exit(1)
try:
    value = json.loads(match.group(1))[0]
    value = codecs.decode(value, "rot_13")
    for marker in ("@$", "^^", "~@", "%?", "*~", "!!", "#&"):
        value = value.replace(marker, "")
    value = b64decode(value + "=" * (-len(value) % 4)).decode()
    value = "".join(chr(ord(char) - 3) for char in value)[::-1]
    payload = json.loads(b64decode(value + "=" * (-len(value) % 4)))
    media_url = payload.get("source", "")
    parsed = urlparse(media_url)
    if parsed.scheme not in ("http", "https") or not parsed.netloc or ".m3u8" not in parsed.path:
        sys.exit(1)
except (ValueError, KeyError, IndexError, TypeError, UnicodeError):
    sys.exit(1)
print(media_url)
' "$embed"
}

extract_with_ytdlp() {
    command -v yt-dlp >/dev/null 2>&1 || return 1
    yt-dlp -g -f "best[protocol^=http]" "$1" 2>/dev/null | head -n 1
}

# Los HLS de Zilla (AV1) fallan al buscar en FFmpeg 6 o anterior.
zilla_supported() {
    local v
    v="$(mpv --version 2>/dev/null)" || return 0
    printf '%s\n' "$v" | grep -qE '^FFmpeg version: [0-6]\.' && return 1
    return 0
}

# Devuelve "enlace<TAB>referrer<TAB>servidor" o falla.
resolve_animeav1_episode() {
    local slug="$1" ep="$2"
    local page data embeds downloads lang
    local want entries entry url direct

    page="$(curl -s -A "$UA" -L --max-time 30 --connect-timeout 10 "$ANIMEAV1/media/$slug/$ep")"
    data="$(printf '%s' "$page" | tr '\n' ' ')"
    embeds="$(printf '%s' "$data" | sed -nE 's|.*embeds:\{(.*)\},downloads:\{.*|\1|p')"
    downloads="$(printf '%s' "$data" | sed -nE 's|.*downloads:\{(.*)\}\},uses:.*|\1|p')"
    [ -z "$embeds" ] && [ -z "$downloads" ] && return 1

    lang="$(pick_animeav1_language "${embeds}${downloads}")" || return 1

    for want in HLS Voe PDrain Pixeldrain YourUpload MP4Upload; do
        entries="$(extract_animeav1_entries "$embeds" "$lang")"
        entry="$(printf '%s\n' "$entries" | grep -iE "server:\"$want\"" | head -n 1)"
        [ -z "$entry" ] && continue
        url="$(printf '%s' "$entry" | sed -nE 's|.*url:"([^"]+)".*|\1|p')"
        [ -z "$url" ] && continue

        direct=""
        case "$want" in
            HLS) zilla_supported && direct="$(extract_animeav1_hls_link "$url")" ;;
            Voe) direct="$(extract_animeav1_voe_link "$url")" ;;
            PDrain|Pixeldrain) direct="$(extract_animeav1_pdrain_link "$url")" ;;
            MP4Upload) direct="$(extract_animeav1_mp4upload_link "$url")" ;;
            YourUpload) direct="$(extract_with_ytdlp "$url")" ;;
        esac

        [ -n "$direct" ] && { printf '%s\t%s\t%s\t%s\t%s\n' "$direct" "$url" "" "" "$want"; return 0; }
    done

    # Respaldo: MP4Upload desde la seccion de descargas.
    entries="$(extract_animeav1_entries "$downloads" "$lang")"
    entry="$(printf '%s\n' "$entries" | grep -iE 'server:"MP4Upload"' | head -n 1)"
    if [ -n "$entry" ]; then
        url="$(printf '%s' "$entry" | sed -nE 's|.*url:"([^"]+)".*|\1|p')"
        url="$(printf '%s' "$url" | sed -E 's|/([[:alnum:]]+)$|/embed-\1.html|')"
        direct="$(extract_animeav1_mp4upload_link "$url")"
        [ -n "$direct" ] && { printf '%s\t%s\t%s\t%s\t%s\n' "$direct" "$url" "" "" "MP4Upload"; return 0; }
    fi

    return 1
}

# ---------------------------------------------------------------------------
# Miruro (respaldo / fuente alternativa: s-sub 1080p en espanol)
# ---------------------------------------------------------------------------

# Miruro es una app sobre AniList. Su API vive en el dominio oficial
# "Miruro 2.0" (barelystarted.miruro.tv):
#   - /api/search/browse?q=<q>&limit=8&type=ANIME  -> resultados (id + titulos)
#   - /watch/<id>                                   -> HTML con los episodios
#   - /api/sources?id=<id>&n=<ep>                   -> servidores y streams
# El track "ssub" (softsub) trae subtitulos externos en espanol y varios
# proveedores (sun, bee, hop, bun...) por si uno cae.

miruro_get() {
    curl -s -A "$UA" -L --max-time 30 --connect-timeout 10 "$1"
}

# Busca en Miruro. Devuelve lineas "id<TAB>titulo".
miruro_search() {
    local q
    q="$(jq -rn --arg s "$1" '$s|@uri')"
    miruro_get "$MIRURO/api/search/browse?q=$q&limit=8&type=ANIME" \
        | python3 -I -c '
import json, sys
try:
    data = json.load(sys.stdin).get("data") or []
except Exception:
    sys.exit(0)
for item in data:
    title = item.get("title") or {}
    name = title.get("romaji") or title.get("english") or title.get("native") or ""
    if item.get("format") == "MOVIE":
        name += " [Pelicula]"
    ident = item.get("id")
    if name and ident:
        print(f"{ident}\t{name}")
'
}

# Lista de episodios de un anime (id de Miruro). Devuelve un numero por linea.
# El /watch/ trae los episodios dentro de un script; se toman sus numeros.
miruro_episodes() {
    miruro_get "$MIRURO/watch/$1" | python3 -I -c '
import re, sys
h = sys.stdin.read()
# Los episodios viven en el script de datos: los 1-2 primeros se declaran
# antes de "episodes:[" y el resto dentro del arreglo. Se acota desde el
# inicio de ese script hasta el siguiente (el de "resolve(2").
i = h.find(".resolve(1")
if i < 0:
    sys.exit(0)
j = h.find("resolve(2", i)
seg = h[i:j if j > i else i + 200000]
seen = []
for n in re.findall(r"number[:=](\d+(?:\.\d+)?)", seg):
    if n not in seen:
        seen.append(n)
seen.sort(key=lambda x: float(x))
print("\n".join(seen))
'
}

# Pide los servidores de un episodio y elige un stream ssub en la mejor
# resolucion (1080p). Prioriza los proveedores con subtitulo en espanol y,
# si ninguno lo trae, usa el primer stream reproducible.
# Devuelve "enlace<TAB>referrer<TAB>origin<TAB>subtitulo<TAB>servidor" o falla.
resolve_miruro_episode() {
    local id="$1" ep="$2" json
    json="$(miruro_get "$MIRURO/api/sources?id=$id&n=$ep")"
    [ -z "$json" ] && return 1

    printf '%s' "$json" | python3 -I -c '
import json, re, ssl, sys, urllib.parse, urllib.request

try:
    data = json.load(sys.stdin)
except Exception:
    sys.exit(1)

ssub = next((t for t in data.get("tracks", []) if t.get("track") == "ssub"), None)
if not ssub:
    sys.exit(1)

order = list(data.get("providerOrder") or [])
provs = {p["provider"]: p for p in ssub.get("providers", [])}
order += [p for p in provs if p not in order]

ctx = ssl.create_default_context()
ctx.check_hostname = False
ctx.verify_mode = ssl.CERT_NONE

def fetch(url, headers, limit=262144):
    req = urllib.request.Request(url, headers=headers)
    with urllib.request.urlopen(req, timeout=20, context=ctx) as resp:
        return resp.read(limit).decode("utf-8", "replace")

def best_variant(master, headers):
    """Devuelve la variante de mayor resolucion (p. ej. 1080p) de un master."""
    txt = fetch(master, headers)
    if not txt.lstrip().startswith("#EXTM3U"):
        return None
    if "#EXT-X-STREAM-INF" not in txt:
        return master
    lines = [ln.strip() for ln in txt.splitlines()]
    best = None
    for k, ln in enumerate(lines):
        if not ln.startswith("#EXT-X-STREAM-INF"):
            continue
        res = re.search(r"RESOLUTION=(\d+)x(\d+)", ln)
        bw = re.search(r"BANDWIDTH=(\d+)", ln)
        height = int(res.group(2)) if res else 0
        bandwidth = int(bw.group(1)) if bw else 0
        nxt = k + 1
        while nxt < len(lines) and lines[nxt].startswith("#"):
            nxt += 1
        if nxt >= len(lines):
            continue
        url = urllib.parse.urljoin(master, lines[nxt])
        if best is None or (height, bandwidth) > best[0]:
            best = ((height, bandwidth), url)
    return best[1] if best else None

def pick_sub(provider):
    """Prefiere subtitulo en espanol (Latinoamerica o Espana)."""
    subs = provider.get("subtitles") or []
    for lang in ("sp", "es"):
        for sub in subs:
            if sub.get("language") == lang:
                return sub
    return None

def try_provider(name, want_sub):
    """Devuelve el primer stream reproducible de un proveedor, o None.

    Si want_sub es True solo considera proveedores con subtitulo en espanol.
    """
    provider = provs.get(name)
    if not provider:
        return None
    sub = pick_sub(provider)
    if want_sub and not sub:
        return None
    for server in provider.get("servers", []):
        for stream in server.get("streams", []):
            url = stream.get("url")
            if not url:
                continue
            headers = server.get("headers") or {}
            try:
                variant = best_variant(url, headers)
            except Exception:
                variant = None
            if variant:
                return {
                    "url": variant,
                    "referer": headers.get("Referer", ""),
                    "origin": headers.get("Origin", ""),
                    "sub": sub.get("file") if sub else "",
                    "provider": name,
                }
    return None

# 1) Proveedores con subtitulo en espanol (lo ideal): se para en el primero.
for name in order:
    chosen = try_provider(name, want_sub=True)
    if chosen:
        break
else:
    # 2) Ninguno trae subtitulo: cualquier stream reproducible (mejor que nada).
    chosen = None
    for name in order:
        chosen = try_provider(name, want_sub=False)
        if chosen:
            break

if not chosen:
    sys.exit(1)

print("\t".join([
    chosen["url"],
    chosen["referer"],
    chosen["origin"],
    chosen["sub"],
    chosen["provider"],
]))
'
}

# ---------------------------------------------------------------------------
# Resolucion combinada: fuente elegida por el usuario (AnimeAV1 o Miruro)
# ---------------------------------------------------------------------------

# Fuente por defecto guardada en disco: "av1" (AnimeAV1) o "miruro".
SOURCE_DEFAULT=""
# Fuente realmente usada en esta ejecucion (puede cambiar si la otra falla).
SOURCE=""
# Resultados de la busqueda, como lineas "id<TAB>titulo" (id = slug o id miruro).
RESULTADOS=""
# Episodios de la ficha elegida, un numero por linea.
EP_LIST=""

# Lee la fuente guardada; por defecto AnimeAV1.
load_source() {
    local s=""
    [ -f "$SOURCE_FILE" ] && s="$(cat "$SOURCE_FILE" 2>/dev/null)"
    case "$s" in
        miruro) SOURCE_DEFAULT="miruro" ;;
        *)      SOURCE_DEFAULT="av1" ;;
    esac
}

# Guarda la fuente elegida.
save_source() {
    mkdir -p "$HISTORY_DIR"
    printf '%s\n' "$1" > "$SOURCE_FILE"
}

# Nombre legible de una fuente.
source_label() {
    case "$1" in
        av1)    printf 'AnimeAV1' ;;
        miruro) printf 'Miruro (s-sub 1080p)' ;;
        *)      printf '%s' "$1" ;;
    esac
}

# Menu para cambiar de fuente.
choose_source() {
    local eleccion
    eleccion="$(printf '%s\n' "AnimeAV1" "Miruro (s-sub 1080p)" \
        | fzf --prompt="Fuente: " --reverse --cycle --height=~10 --border)"
    case "$eleccion" in
        AnimeAV1)               save_source "av1" ;;
        "Miruro (s-sub 1080p)") save_source "miruro" ;;
        *)                      return 1 ;;
    esac
    load_source
    echo -e "Fuente: ${GREEN}$(source_label "$SOURCE_DEFAULT")${NC}"
}

# Busca en una fuente concreta. Deja los resultados en RESULTADOS.
search_in_source() {
    case "$1" in
        miruro) RESULTADOS="$(miruro_search "$2")" ;;
        *)      RESULTADOS="$(animeav1_search "$2")" ;;
    esac
    [ -n "$RESULTADOS" ]
}

# Busca con la fuente elegida y, si no da resultados (sitio caido), prueba la
# otra automaticamente. Deja RESULTADOS y SOURCE listos.
search_anime() {
    local query="$1" fallback
    if [ "$SOURCE_DEFAULT" == "miruro" ]; then
        fallback="av1"
    else
        fallback="miruro"
    fi
    if search_in_source "$SOURCE_DEFAULT" "$query"; then
        SOURCE="$SOURCE_DEFAULT"
        return 0
    fi
    if search_in_source "$fallback" "$query"; then
        SOURCE="$fallback"
        echo -e "${YELLOW}$(source_label "$SOURCE_DEFAULT") no disponible; usando $(source_label "$fallback").${NC}"
        return 0
    fi
    return 1
}

# Deja en EP_LIST los numeros de episodio de la ficha, segun la fuente activa.
list_episodes() {
    local id="$1"
    case "$SOURCE" in
        miruro) EP_LIST="$(miruro_episodes "$id")" ;;
        *)      EP_LIST="$(animeav1_episodes "$id")" ;;
    esac
    [ -n "$EP_LIST" ]
}

# Resuelve un episodio en una fuente concreta (id = slug av1 o id miruro).
resolve_in_source() {
    case "$1" in
        miruro) resolve_miruro_episode "$2" "$3" ;;
        *)      resolve_animeav1_episode "$2" "$3" ;;
    esac
}

# Devuelve "enlace<TAB>referrer<TAB>origin<TAB>subtitulo<TAB>servidor".
# Usa la fuente activa y, si no resuelve, reintenta con la otra.
resolve_episode() {
    local id="$1" ep="$2" title="$3" resuelto other other_results other_id

    resuelto="$(resolve_in_source "$SOURCE" "$id" "$ep")"
    [ -n "$resuelto" ] && { printf '%s\n' "$resuelto"; return 0; }

    if [ "$SOURCE" == "miruro" ]; then other="av1"; else other="miruro"; fi
    case "$other" in
        miruro) other_results="$(miruro_search "$title")" ;;
        *)      other_results="$(animeav1_search "$title")" ;;
    esac
    other_id="$(printf '%s\n' "$other_results" | head -n 1 | cut -f1)"
    [ -z "$other_id" ] && return 1

    resuelto="$(resolve_in_source "$other" "$other_id" "$ep")"
    [ -n "$resuelto" ] && { printf '%s\n' "$resuelto"; return 0; }
    return 1
}

main() {

check_dependencies curl fzf grep sed python3 mpv jq

urlo="https://raw.githubusercontent.com/rlssj/ani-neko/refs/heads/main/ani-neko"
SCRIPT_DIR=$(dirname "$(readlink -f "$0")")
ARCHIVO="$SCRIPT_DIR/ani-neko"

echo -e "${BLUE}Verificando actualizaciones disponibles...${NC}"
update=$(curl -s "$urlo")

if [ "$update" != "$(cat "$ARCHIVO")" ]; then
    echo -n -e "${CYAN}Hay una actualizacion disponible se recomienda actualizar para garantizar que el script funcione correctamente (y/n) ${NC}"
    read ele
    if [ "$ele" == "y" ]; then
        diff -u "$ARCHIVO" <(echo "$update") | sudo patch "$ARCHIVO" > /dev/null 2>&1 && echo -e "${CYAN}El script ha sido actualizado${NC}" || echo -e "${RED}Ha ocurrido un error mientras se actualizaba el script${NC}"
        exit 0
    fi
else
    echo "Script actualizado"
fi

clear

load_source

# -s / --source: cambiar la fuente y salir.
if [ "$CHANGE_SOURCE" == 1 ]; then
    echo -e "Fuente actual: ${GREEN}$(source_label "$SOURCE_DEFAULT")${NC}"
    choose_source
    exit 0
fi

echo -e "Fuente: ${GREEN}$(source_label "$SOURCE_DEFAULT")${NC}  (cambiar con: ani-neko -s)"

if [[ -z "$arg1" ]]; then
  read -rp "Search anime: " oracion
  clear
else
  oracion="$arg1"
fi

if ! search_anime "$oracion"; then
  echo -e "${RED}No results found!${NC}"
  exit 1
fi

# Menu numerado (1 Death Note, 2 Death Note: Rewrite, ...) como ani-cli
menu=$(printf '%s\n' "$RESULTADOS" | cut -f2 | awk '{printf "%d %s\n", NR, $0}')
eleccion=$(printf '%s\n' "$menu" | fzf --prompt="Select anime: " --reverse --cycle --height=~20 --border)

if [ -z "$eleccion" ]; then
  exit 0
fi

num=$(printf '%s' "$eleccion" | awk '{print $1}')
titulo_elegido=$(printf '%s\n' "$RESULTADOS" | sed -n "${num}p" | cut -f2)
slug=$(printf '%s\n' "$RESULTADOS" | sed -n "${num}p" | cut -f1)

clear
echo -e "Anime: ${GREEN}${titulo_elegido}${NC}"

if ! list_episodes "$slug"; then
  echo -e "${RED}No se encontraron episodios para:${NC} $titulo_elegido"
  exit 1
fi
ep_list="$EP_LIST"

last_cap=$(get_last_cap "$titulo_elegido")
echo -e "Ultimo episodio visto: $last_cap"

if [ "$CONTINUE" == 1 ] && [ -n "$last_cap" ]; then
  capi="$last_cap"
  progress=$(get_progress "$titulo_elegido")
else
  capi=$(printf '%s\n' "$ep_list" | fzf \
    --prompt="Select episode: " \
    --reverse --cycle \
    --height=~30 \
    --border)
fi

if [ -z "$capi" ]; then
  exit 0
fi

clear


videocap(){
local ep="$1"

echo "Buscando enlace del episodio $ep..."

resuelto="$(resolve_episode "$slug" "$ep" "$titulo_elegido")"

if [ -z "$resuelto" ]; then
  echo -e "${RED}No hay version SUB (audio japones, subtitulos en espanol) para el episodio $ep.${NC}"
  echo -e "${YELLOW}Ni AnimeAV1 ni Miruro tienen ese episodio en SUB.${NC}"
  return 1
fi

# Formato: enlace<TAB>referrer<TAB>origin<TAB>subtitulo<TAB>servidor
src_contenido="$(printf '%s' "$resuelto" | cut -f1)"
referrer="$(printf '%s' "$resuelto" | cut -f2)"
origin="$(printf '%s' "$resuelto" | cut -f3)"
sub_file="$(printf '%s' "$resuelto" | cut -f4)"
servidor="$(printf '%s' "$resuelto" | cut -f5)"

clear
echo "Capitulo: $ep  (${servidor})"

ENV=$(detect_env)
pos=0

# Cabeceras extra que algunos servidores exigen (Miruro: Origin; Zilla: CORS).
# El Referer va aparte con --referrer.
if [ "$servidor" == "HLS" ]; then
    extra_headers=(--http-header-fields="$ZILLA_HEADERS")
elif [ -n "$origin" ]; then
    extra_headers=(--http-header-fields="Origin: $origin")
else
    extra_headers=()
fi

# Subtitulo externo en espanol (solo Miruro lo aporta; AnimeAV1 ya es hardsub).
extra_subs=()
[ -n "$sub_file" ] && extra_subs=(--sub-file="$sub_file")

# Algunos HLS usan extensiones de segmento falsas (.jpg, .woff2). Hay que
# permitir cualquier extension para que FFmpeg los abra.
extra_opts=(--stream-lavf-o=allowed_extensions=ALL)

case "$ENV" in
    wsl)
        if command -v mpv.exe >/dev/null 2>&1; then
            pos=$(mpv.exe --start="$progress" --referrer="$referrer" "${extra_headers[@]}" "${extra_subs[@]}" "${extra_opts[@]}" --msg-level=ffmpeg=no --force-media-title="$titulo_elegido-$ep" "$src_contenido" | grep -oE 'AV: [0-9]{2}:[0-9]{2}:[0-9]{2}' | tail -n 1 | sed 's/AV: //g' 2>&1)
        else
            echo "mpv.exe no encontrado en Windows PATH"
        fi
        ;;
    termux)
        if pm list packages | grep -q 'org.videolan.vlc'; then
            am start -a android.intent.action.VIEW -d "$src_contenido" -n org.videolan.vlc/org.videolan.vlc.gui.video.VideoPlayerActivity
            pos=0
        else
            termux-open-url "$src_contenido"
            pos=0
        fi
        ;;
    linux)
        if command -v mpv >/dev/null 2>&1; then
            pos=$(mpv --start="$progress" --referrer="$referrer" "${extra_headers[@]}" "${extra_subs[@]}" "${extra_opts[@]}" --msg-level=ffmpeg=no --force-media-title="$titulo_elegido-$ep" "$src_contenido" | grep -oE 'AV: [0-9]{2}:[0-9]{2}:[0-9]{2}' | tail -n 1 | sed 's/AV: //g' 2>&1)
        fi
        ;;
esac

save_history "$titulo_elegido" "$ep" "$pos"

op=$( (echo "Siguiente"; echo "Retroceder"; echo "Atras") | tac | fzf --prompt="Selecciona una opción: " --height=7 --border --info=inline --margin=1,1,0,0)

if [[ "$op" == "Siguiente" ]]; then
    progress="00:00:00"
    ep=$(printf '%s\n' "$ep_list" | sed -n "/^${ep}$/{n;p;}")
    [ -n "$ep" ] && videocap "$ep"
elif [[ "$op" == "Retroceder" ]]; then
    progress="00:00:00"
    ep=$(printf '%s\n' "$ep_list" | sed -n "/^${ep}$/{g;1!p;};h")
    [ -n "$ep" ] && videocap "$ep"
elif [[ "$op" == "Atras" ]]; then
    main
fi
}
videocap "$capi"
}



main
