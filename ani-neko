#!/bin/bash

VERSION="2.0.0"

CONTINUE=0
progress="00:00:00"

# cosas para texto
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[0;33m'
BLUE='\033[0;34m'
PURPLE='\033[0;35m'
CYAN='\033[0;36m'
WHITE='\033[0;37m'

# cosas para el fondo del texto
BG_RED='\033[41m'
BG_GREEN='\033[42m'
BG_YELLOW='\033[43m'
BG_BLUE='\033[44m'
BG_PURPLE='\033[45m'
BG_CYAN='\033[46m'
BG_WHITE='\033[47m'

NC='\033[0m'

UA="Mozilla/5.0 (Windows NT 10.0; Win64; x64; rv:109.0) Gecko/20100101 Firefox/121.0"
ANIMEAV1="https://animeav1.com"
ZILLA_HEADERS="Origin:https://player.zilla-networks.com,Sec-Fetch-Dest:empty,Sec-Fetch-Mode:cors,Sec-Fetch-Site:same-origin"

HISTORY_DIR="$HOME/ani-es"
OLD_DB="$HISTORY_DIR/history.db"
HISTORY_FILE="$HISTORY_DIR/history.json"

WORKDIR="$(mktemp -d)"
trap 'rm -rf "$WORKDIR"' EXIT


init_history() {

    mkdir -p "$HISTORY_DIR"

    [[ -f "$HISTORY_FILE" ]] || echo "{}" > "$HISTORY_FILE"

    if [[ -f "$OLD_DB" ]]; then

        echo
        echo "El sistema de guardado de historial ha cambiado."
        read -rp "¿Desea importar su antiguo historial? (y/n): " respuesta

        if [[ "$respuesta" =~ ^[YySs]$ ]]; then

            echo "Importando historial..."

            if python3 <<EOF
import sqlite3
import json

db_path = "$OLD_DB"
json_path = "$HISTORY_FILE"

try:
    with open(json_path, "r", encoding="utf-8") as f:
        history = json.load(f)
except:
    history = {}

conn = sqlite3.connect(db_path)
cursor = conn.cursor()

cursor.execute("""
SELECT name
FROM sqlite_master
WHERE type='table' AND name='animes'
""")

if cursor.fetchone():

    cursor.execute("SELECT anime,last_cap,progress FROM animes")

    for anime,last_cap,progress in cursor.fetchall():

        try:
            last_cap = int(last_cap)
        except (TypeError, ValueError):
            last_cap = 0

        if not progress:
            progress = "00:00:00"

        history[anime] = {
            "last_cap": last_cap,
            "progress": progress
        }

conn.close()

with open(json_path, "w", encoding="utf-8") as f:
    json.dump(history, f, indent=4, ensure_ascii=False)

EOF
            then
                rm -f "$OLD_DB"
                echo "Historial importado correctamente."
            else
                echo "Ha ocurrido un error durante la importación."
                echo "La base de datos antigua no se ha eliminado."
            fi

        else
            rm -f "$OLD_DB"
            echo "El historial antiguo ha sido eliminado."
        fi
    fi
}

init_history

clear

get_last_cap() {
    jq -r --arg anime "$1" \
        '.[$anime].last_cap // ""' \
        "$HISTORY_FILE"
}


get_progress() {
    jq -r --arg anime "$1" \
        '.[$anime].progress // "00:00:00"' \
        "$HISTORY_FILE"
}


save_history() {
    local anime="$1"
    local cap="$2"
    local progress="$3"

    tmp=$(mktemp)

    jq \
        --arg anime "$anime" \
        --arg cap "$cap" \
        --arg progress "$progress" \
        '.[$anime] = {
            last_cap: ($cap|tonumber),
            progress: $progress
        }' \
        "$HISTORY_FILE" > "$tmp"

    mv "$tmp" "$HISTORY_FILE"
}


show_help() {
    echo ""
    echo "    Uso: ani-neko [opciones] [busqueda]"
    echo ""
    echo "    Opciones:"
    echo "      -h, --help       Mostrar ayuda"
    echo "      -v, --version    Mostrar versión"
    echo "      -c, --continue   Continua el anime en donde ultimo lo dejaste"
    echo ""
}

show_version() {
    echo -e "ani-neko ${PURPLE}v${VERSION}${NC}"
}

# parseo de argumentos
while [[ $# -gt 0 ]]; do
    case "$1" in
        -h|--help)
            show_help
            exit 0
            ;;
        -v|--version)
            show_version
            exit 0
            ;;
        -c|--continue)
            CONTINUE=1
            ;;
        *)
            break
            ;;
    esac
    shift
done


arg1="$*"


check_dependencies() {
    local missing=()

    echo "Checking dependencies..."

    for cmd in "$@"; do
        if ! command -v "$cmd" &> /dev/null; then
            missing+=("$cmd")
        fi
    done

    if [ ${#missing[@]} -ne 0 ]; then
        echo -e "${RED}Dependencias faltantes:${NC}"
        for pkg in "${missing[@]}"; do
            echo -e "${CYAN}  - $pkg ${NC}"
        done
        echo -e "${GREEN}Ejecuta el instalador antes de usar este script.${NC}"
        exit 1
    fi
}

detect_env() {
    # WSL (1 o 2)
    if grep -qi microsoft /proc/version 2>/dev/null || [ -n "$WSL_DISTRO_NAME" ]; then
        echo "wsl"
    # Termux (Android)
    elif [ -n "$PREFIX" ] && [[ "$PREFIX" == *com.termux* ]]; then
        echo "termux"
    # Linux normal
    else
        echo "linux"
    fi
}

# ---------------------------------------------------------------------------
# AnimeAV1
# ---------------------------------------------------------------------------

# Busca en el catalogo. Devuelve lineas "slug<TAB>titulo".
animeav1_search() {
    curl -s -A "$UA" -L "$ANIMEAV1/catalogo?search=$(printf '%s' "$1" | sed 's/ /+/g')" \
        | tr '\n' ' ' \
        | sed 's|<article class="group/item|\n&|g' \
        | sed -nE 's|.*<h3[^>]*>([^<]+)</h3>.*href="/media/([^"/?]+)".*|\2\t\1|p'
}

# Lista de episodios de un anime (slug).
animeav1_episodes() {
    curl -s -A "$UA" -L "$ANIMEAV1/media/$1" \
        | tr '\n' ' ' \
        | grep -oE 'number:[0-9]+(\.[0-9]+)?' | cut -d: -f2 \
        | awk '!seen[$0]++' | sort -n
}

# Elige el idioma disponible (prefiere SUB, luego ESP/LAT/DUB).
pick_animeav1_language() {
    local l
    for l in SUB ESP LAT DUB; do
        printf '%s' "$1" | grep -q "${l}:\[" && { printf '%s\n' "$l"; return 0; }
    done
    return 1
}

# Extrae las entradas "server:...,url:..." de un idioma del blob embeds/downloads.
extract_animeav1_entries() {
    [ -z "$1" ] && return 1
    printf '%s' "$1" | sed "s|.*$2:\\[||" \
        | sed 's|],*[A-Z][A-Z0-9]*:\[.*||; s|]$||; s|},{|}\n{|g'
}

extract_animeav1_hls_link() {
    local id
    id="$(printf '%s' "$1" | sed -nE 's|.*/play/([[:alnum:]]+).*|\1|p')"
    [ -n "$id" ] && printf 'https://player.zilla-networks.com/m3u8/%s\n' "$id"
}

extract_animeav1_pdrain_link() {
    local id
    id="$(printf '%s' "$1" | sed -nE 's|^https://pixeldrain\.com/u/([[:alnum:]]+)(\?.*)?$|\1|p')"
    [ -n "$id" ] && printf 'https://pixeldrain.com/api/file/%s\n' "$id"
}

extract_animeav1_mp4upload_link() {
    curl -s -A "$UA" -L "$1" \
        | sed -nE 's|.*src:[[:space:]]*"(https?://[^"]+\.mp4[^"]*)".*|\1|p' | head -n 1
}

# Voe publica un JSON ofuscado (ROT13 + base64 + desplazamiento + inversión).
extract_animeav1_voe_link() {
    command -v python3 >/dev/null 2>&1 || return 1
    local embed="$1" page redirect
    page="$(curl -s -A "$UA" -L "$embed")"
    redirect="$(printf '%s' "$page" | sed -nE "s|.*window.location.href = '(https://[^']+/e/[[:alnum:]]+)'.*|\1|p" | head -n 1)"
    if [ -n "$redirect" ]; then
        embed="$redirect"
        page="$(curl -s -A "$UA" -L "$embed")"
    fi
    printf '%s' "$page" | python3 -c '
from base64 import b64decode
import codecs, json, re, sys
from urllib.parse import urlparse

match = re.search(r"<script\s+type=[\x27\x22]application/json[\x27\x22]>(.*?)</script>", sys.stdin.read(), re.S)
if not match:
    sys.exit(1)
try:
    value = json.loads(match.group(1))[0]
    value = codecs.decode(value, "rot_13")
    for marker in ("@$", "^^", "~@", "%?", "*~", "!!", "#&"):
        value = value.replace(marker, "")
    value = b64decode(value + "=" * (-len(value) % 4)).decode()
    value = "".join(chr(ord(char) - 3) for char in value)[::-1]
    payload = json.loads(b64decode(value + "=" * (-len(value) % 4)))
    media_url = payload.get("source", "")
    parsed = urlparse(media_url)
    if parsed.scheme not in ("http", "https") or not parsed.netloc or ".m3u8" not in parsed.path:
        sys.exit(1)
except (ValueError, KeyError, IndexError, TypeError, UnicodeError):
    sys.exit(1)
print(media_url)
' "$embed"
}

extract_with_ytdlp() {
    command -v yt-dlp >/dev/null 2>&1 || return 1
    yt-dlp -g -f "best[protocol^=http]" "$1" 2>/dev/null | head -n 1
}

# Los HLS de Zilla (AV1) fallan al buscar en FFmpeg 6 o anterior.
zilla_supported() {
    local v
    v="$(mpv --version 2>/dev/null)" || return 0
    printf '%s\n' "$v" | grep -qE '^FFmpeg version: [0-6]\.' && return 1
    return 0
}

# Devuelve "enlace<TAB>referrer<TAB>servidor" o falla.
resolve_animeav1_episode() {
    local slug="$1" ep="$2"
    local page data embeds downloads lang
    local want entries entry url direct

    page="$(curl -s -A "$UA" -L "$ANIMEAV1/media/$slug/$ep")"
    data="$(printf '%s' "$page" | tr '\n' ' ')"
    embeds="$(printf '%s' "$data" | sed -nE 's|.*embeds:\{(.*)\},downloads:\{.*|\1|p')"
    downloads="$(printf '%s' "$data" | sed -nE 's|.*downloads:\{(.*)\}\},uses:.*|\1|p')"
    [ -z "$embeds" ] && [ -z "$downloads" ] && return 1

    lang="$(pick_animeav1_language "${embeds}${downloads}")" || return 1

    for want in HLS Voe PDrain Pixeldrain YourUpload MP4Upload; do
        entries="$(extract_animeav1_entries "$embeds" "$lang")"
        entry="$(printf '%s\n' "$entries" | grep -iE "server:\"$want\"" | head -n 1)"
        [ -z "$entry" ] && continue
        url="$(printf '%s' "$entry" | sed -nE 's|.*url:"([^"]+)".*|\1|p')"
        [ -z "$url" ] && continue

        direct=""
        case "$want" in
            HLS) zilla_supported && direct="$(extract_animeav1_hls_link "$url")" ;;
            Voe) direct="$(extract_animeav1_voe_link "$url")" ;;
            PDrain|Pixeldrain) direct="$(extract_animeav1_pdrain_link "$url")" ;;
            MP4Upload) direct="$(extract_animeav1_mp4upload_link "$url")" ;;
            YourUpload) direct="$(extract_with_ytdlp "$url")" ;;
        esac

        [ -n "$direct" ] && { printf '%s\t%s\t%s\n' "$direct" "$url" "$want"; return 0; }
    done

    # Respaldo: MP4Upload desde la seccion de descargas.
    entries="$(extract_animeav1_entries "$downloads" "$lang")"
    entry="$(printf '%s\n' "$entries" | grep -iE 'server:"MP4Upload"' | head -n 1)"
    if [ -n "$entry" ]; then
        url="$(printf '%s' "$entry" | sed -nE 's|.*url:"([^"]+)".*|\1|p')"
        url="$(printf '%s' "$url" | sed -E 's|/([[:alnum:]]+)$|/embed-\1.html|')"
        direct="$(extract_animeav1_mp4upload_link "$url")"
        [ -n "$direct" ] && { printf '%s\t%s\t%s\n' "$direct" "$url" "MP4Upload"; return 0; }
    fi

    return 1
}

main() {

check_dependencies curl fzf grep sed python3 mpv jq

urlo="https://raw.githubusercontent.com/rlssj/ani-neko/refs/heads/main/ani-neko"
SCRIPT_DIR=$(dirname "$(readlink -f "$0")")
ARCHIVO="$SCRIPT_DIR/ani-neko"

echo -e "${BLUE}Verificando actualizaciones disponibles...${NC}"
update=$(curl -s "$urlo")

if [ "$update" != "$(cat "$ARCHIVO")" ]; then
    echo -n -e "${CYAN}Hay una actualizacion disponible se recomienda actualizar para garantizar que el script funcione correctamente (y/n) ${NC}"
    read ele
    if [ "$ele" == "y" ]; then
        diff -u "$ARCHIVO" <(echo "$update") | sudo patch "$ARCHIVO" > /dev/null 2>&1 && echo -e "${CYAN}El script ha sido actualizado${NC}" || echo -e "${RED}Ha ocurrido un error mientras se actualizaba el script${NC}"
        exit 0
    fi
else
    echo "Script actualizado"
fi

clear

if [[ -z "$arg1" ]]; then
  read -rp "Search anime: " oracion
  clear
else
  oracion="$arg1"
fi

resultados="$(animeav1_search "$oracion")"

if [ -z "$resultados" ]; then
  echo -e "${RED}No results found!${NC}"
  exit 1
fi

# Menu numerado (1 Death Note, 2 Death Note: Rewrite, ...) como ani-cli
menu=$(printf '%s\n' "$resultados" | cut -f2 | awk '{printf "%d %s\n", NR, $0}')
eleccion=$(printf '%s\n' "$menu" | fzf --prompt="Select anime: " --reverse --cycle --height=~20 --border)

if [ -z "$eleccion" ]; then
  exit 0
fi

num=$(printf '%s' "$eleccion" | awk '{print $1}')
titulo_elegido=$(printf '%s\n' "$resultados" | sed -n "${num}p" | cut -f2)
slug=$(printf '%s\n' "$resultados" | sed -n "${num}p" | cut -f1)

clear
echo -e "Anime: ${GREEN}${titulo_elegido}${NC}"

ep_list="$(animeav1_episodes "$slug")"

if [ -z "$ep_list" ]; then
  echo -e "${RED}No se encontraron episodios para:${NC} $titulo_elegido"
  exit 1
fi

last_cap=$(get_last_cap "$titulo_elegido")
echo -e "Ultimo episodio visto: $last_cap"

if [ "$CONTINUE" == 1 ] && [ -n "$last_cap" ]; then
  capi="$last_cap"
  progress=$(get_progress "$titulo_elegido")
else
  capi=$(printf '%s\n' "$ep_list" | fzf \
    --prompt="Select episode: " \
    --reverse --cycle \
    --height=~30 \
    --border)
fi

if [ -z "$capi" ]; then
  exit 0
fi

clear


videocap(){
local ep="$1"

echo "Buscando enlace del episodio $ep..."

resuelto="$(resolve_animeav1_episode "$slug" "$ep")"

if [ -z "$resuelto" ]; then
  echo -e "${RED}No se encontró ningún enlace reproducible para el episodio $ep.${NC}"
  return 1
fi

src_contenido="$(printf '%s' "$resuelto" | cut -f1)"
referrer="$(printf '%s' "$resuelto" | cut -f2)"
servidor="$(printf '%s' "$resuelto" | cut -f3)"

clear
echo "Capitulo: $ep  (${servidor})"

ENV=$(detect_env)
pos=0

# Los HLS de Zilla necesitan cabeceras extra de origen
if [ "$servidor" == "HLS" ]; then
    extra_headers=(--http-header-fields="$ZILLA_HEADERS")
else
    extra_headers=()
fi

case "$ENV" in
    wsl)
        if command -v mpv.exe >/dev/null 2>&1; then
            pos=$(mpv.exe --start="$progress" --referrer="$referrer" "${extra_headers[@]}" --msg-level=ffmpeg=no --force-media-title="$titulo_elegido-$ep" "$src_contenido" | grep -oE 'AV: [0-9]{2}:[0-9]{2}:[0-9]{2}' | tail -n 1 | sed 's/AV: //g' 2>&1)
        else
            echo "mpv.exe no encontrado en Windows PATH"
        fi
        ;;
    termux)
        if pm list packages | grep -q 'org.videolan.vlc'; then
            am start -a android.intent.action.VIEW -d "$src_contenido" -n org.videolan.vlc/org.videolan.vlc.gui.video.VideoPlayerActivity
            pos=0
        else
            termux-open-url "$src_contenido"
            pos=0
        fi
        ;;
    linux)
        if command -v mpv >/dev/null 2>&1; then
            pos=$(mpv --start="$progress" --referrer="$referrer" "${extra_headers[@]}" --msg-level=ffmpeg=no --force-media-title="$titulo_elegido-$ep" "$src_contenido" | grep -oE 'AV: [0-9]{2}:[0-9]{2}:[0-9]{2}' | tail -n 1 | sed 's/AV: //g' 2>&1)
        fi
        ;;
esac

save_history "$titulo_elegido" "$ep" "$pos"

op=$( (echo "Siguiente"; echo "Retroceder"; echo "Atras") | tac | fzf --prompt="Selecciona una opción: " --height=7 --border --info=inline --margin=1,1,0,0)

if [[ "$op" == "Siguiente" ]]; then
    progress="00:00:00"
    ep=$(printf '%s\n' "$ep_list" | sed -n "/^${ep}$/{n;p;}")
    [ -n "$ep" ] && videocap "$ep"
elif [[ "$op" == "Retroceder" ]]; then
    progress="00:00:00"
    ep=$(printf '%s\n' "$ep_list" | sed -n "/^${ep}$/{g;1!p;};h")
    [ -n "$ep" ] && videocap "$ep"
elif [[ "$op" == "Atras" ]]; then
    main
fi
}
videocap "$capi"
}



main
